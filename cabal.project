packages: .

-- So that a plain `cabal build && cabal test` drops a .ghc.environment file,
-- letting the error-location test's bare `ghc` find the circuit-notation
-- plugin (the same mechanism CI uses to compile the Example module).
write-ghc-environment-files: always

-- TODO: Remove once a Clash release supporting GHC 9.14 is on Hackage.
if impl(ghc >= 9.14)
  source-repository-package
    type: git
    location: https://github.com/clash-lang/clash-compiler.git
    tag: 867786f9d3001ca78602d10abab791c58aa9f15a
    subdir: clash-prelude
